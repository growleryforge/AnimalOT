         deviceId: UUID = UUID(),
         startedAt: Date = Date()) {
        self.id = id
        self.childId = childId
        self.gameId = gameId
        self.deviceId = deviceId
        self.startedAt = startedAt
    }
}

/// Parent-added interpretation. Gains media + a gameId link vs. the prior spec.
@Model
final class Observation {
    var id: UUID = UUID()
    var childId: UUID = UUID()
    var authorId: UUID?
    var gameId: UUID?
    var timestamp: Date = Date()

    // Auto-prefilled from the Game where possible.
    var systemRaw: String?
    var pattern: String = ""
    var controlRaw: String = ControlState.unknown.rawValue

    var observationDescription: String?
    var beforeState: String?
    var afterState: String?
    var intensity: Int?       // 1...5
    var context: String?
    var tags: [String] = []

    @Relationship(deleteRule: .cascade) var media: [MediaAsset]? = []

    var system: SensorySystem? {
        get { systemRaw.flatMap { SensorySystem(rawValue: $0) } }
        set { systemRaw = newValue?.rawValue }
    }
    var control: ControlState {
        get { ControlState(rawValue: controlRaw) ?? .unknown }
        set { controlRaw = newValue.rawValue }
    }

    /// Derived: did this input calm him? (after better than before)
    var isRegulating: Bool {
        guard let before = beforeState?.lowercased(),
              let after = afterState?.lowercased() else { return false }
        let calmWords = ["calm", "settled", "regulated", "calmer", "settles"]
        let calmAfter = calmWords.contains { after.contains($0) }
        let dysregBefore = ["wound", "dysreg", "amped", "escalat", "agitat"]
            .contains { before.contains($0) }
        return calmAfter && dysregBefore
    }

    init(id: UUID = UUID(),
         childId: UUID = UUID(),
         authorId: UUID? = nil,
         gameId: UUID? = nil,
         timestamp: Date = Date(),
         system: SensorySystem? = nil,
         pattern: String = "",
         control: ControlState = .unknown,
         description: String? = nil,
         beforeState: String? = nil,
         afterState: String? = nil,
         intensity: Int? = nil,
         context: String? = nil,
         tags: [String] = []) {
        self.id = id
        self.childId = childId
        self.authorId = authorId
        self.gameId = gameId
        self.timestamp = timestamp
        self.systemRaw = system?.rawValue
        self.pattern = pattern
        self.controlRaw = control.rawValue
        self.observationDescription = description
        self.beforeState = beforeState
        self.afterState = afterState
        self.intensity = intensity
        self.context = context
        self.tags = tags
    }
}

@Model
final class MediaAsset {
    var id: UUID = UUID()
    var typeRaw: String = MediaType.video.rawValue
    var sourceRaw: String = MediaSource.kidFrontCam.rawValue
    /// Local file URL (relative to the app's container). Synced via family iCloud.
    var uri: String = ""
    var thumbnailURI: String?
    var capturedAt: Date = Date()
    var retentionUntil: Date?

    var type: MediaType {
        get { MediaType(rawValue: typeRaw) ?? .video }
        set { typeRaw = newValue.rawValue }
    }
    var source: MediaSource {
        get { MediaSource(rawValue: sourceRaw) ?? .kidFrontCam }
        set { sourceRaw = newValue.rawValue }
    }

    init(id: UUID = UUID(),
         type: MediaType = .video,
         source: MediaSource = .kidFrontCam,
         uri: String = "",
         thumbnailURI: String? = nil,
         capturedAt: Date = Date(),
         retentionUntil: Date? = nil) {
        self.id = id
        self.typeRaw = type.rawValue
        self.sourceRaw = source.rawValue
        self.uri = uri
        self.thumbnailURI = thumbnailURI
        self.capturedAt = capturedAt
        self.retentionUntil = retentionUntil
    }
}

@Model
final class BehaviorEvent {
    var id: UUID = UUID()
    var sessionId: UUID = UUID()
    var kindRaw: String = BehaviorKind.choice.rawValue
    /// Stringified value (game id, volume level, seconds, etc.).
    var value: String = ""
    var at: Date = Date()

    var kind: BehaviorKind {
        get { BehaviorKind(rawValue: kindRaw) ?? .choice }
        set { kindRaw = newValue.rawValue }
    }

    init(id: UUID = UUID(),
         sessionId: UUID = UUID(),
         kind: BehaviorKind = .choice,
         value: String = "",
         at: Date = Date()) {
        self.id = id
        self.sessionId = sessionId
        self.kindRaw = kind.rawValue
        self.value = value
        self.at = at
    }
}

