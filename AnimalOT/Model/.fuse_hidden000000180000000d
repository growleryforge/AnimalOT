import Foundation
import SwiftData

// MARK: - Data model
//
// Family-generic from day one (childId / familyId everywhere) so multi-family is
// a later flip, not a rewrite. CloudKit-backed SwiftData constraints are honored:
//   • every stored property has a default or is optional
//   • relationships are optional
//   • no .unique attributes
//
// Enums are stored as raw strings (`*Raw`) with typed computed accessors.

@Model
final class Family {
    var id: UUID = UUID()
    var name: String = ""
    var createdAt: Date = Date()

    @Relationship(deleteRule: .cascade) var children: [Child]? = []
    @Relationship(deleteRule: .cascade) var members: [AppUser]? = []

    init(id: UUID = UUID(), name: String = "") {
        self.id = id
        self.name = name
        self.createdAt = Date()
    }
}

@Model
final class Child {
    var id: UUID = UUID()
    var familyId: UUID = UUID()
    var displayName: String = ""
    var birthdate: Date?
    /// Stored as raw strings; what he likes (drives game matching).
    var interests: [String] = []
    /// e.g. "PDA", "light-sensitive".
    var profileFlags: [String] = []

    init(id: UUID = UUID(),
         familyId: UUID = UUID(),
         displayName: String = "",
         birthdate: Date? = nil,
         interests: [String] = [],
         profileFlags: [String] = []) {
        self.id = id
        self.familyId = familyId
        self.displayName = displayName
        self.birthdate = birthdate
        self.interests = interests
        self.profileFlags = profileFlags
    }
}

@Model
final class AppUser {
    var id: UUID = UUID()
    var familyId: UUID = UUID()
    var displayName: String = ""
    var roleRaw: String = UserRole.parent.rawValue

    var role: UserRole {
        get { UserRole(rawValue: roleRaw) ?? .parent }
        set { roleRaw = newValue.rawValue }
    }

    init(id: UUID = UUID(), familyId: UUID = UUID(), displayName: String = "", role: UserRole = .parent) {
        self.id = id
        self.familyId = familyId
        self.displayName = displayName
        self.roleRaw = role.rawValue
    }
}

/// A device is provisioned as kid or parent at setup. Type is identity:
/// it determines which surface the build renders. Enforced in code, not just UI.
@Model
final class AppDevice {
    var id: UUID = UUID()
    var familyId: UUID = UUID()
    var typeRaw: String = DeviceType.parent.rawValue
    var provisionedAt: Date = Date()

    var type: DeviceType {
        get { DeviceType(rawValue: typeRaw) ?? .parent }
        set { typeRaw = newValue.rawValue }
    }

    init(id: UUID = UUID(), familyId: UUID = UUID(), type: DeviceType = .parent) {
        self.id = id
        self.familyId = familyId
        self.typeRaw = type.rawValue
        self.provisionedAt = Date()
    }
}

/// Optional lock on PARENT devices only. The kid device's safety comes from
/// absence of the analytics surface, not from a lock.
@Model
final class FamilySecurity {
    var familyId: UUID = UUID()
    var parentPinHash: String?

    init(familyId: UUID = UUID(), parentPinHash: String? = nil) {
        self.familyId = familyId
        self.parentPinHash = parentPinHash
    }
}

/// The activity the app delivers. A real entity, not a hardcoded list.
@Model
final class Game {
    var id: UUID = UUID()
    var title: String = ""
    var animalTheme: String = ""
    var systemRaw: String = SensorySystem.auditory.rawValue
    var captureModeRaw: String = CaptureMode.either.rawValue
    var phoneHolderRaw: String = PhoneHolder.parentRun.rawValue

    var setup: String = ""
    var steps: [String] = []
    var watchFor: [String] = []
    var likelyMeaning: String = ""
    var tags: [String] = []
    /// Which child interests this lands well with.
    var interestMatch: [String] = []

    /// 1.0 content lives in the child's sneaky+gross lane. This flags the three
    /// first-set hook animals so the kid surface can lead with them.
    var isFirstSet: Bool = false
    /// Order within the kid picker.
    var displayOrder: Int = 0
    /// The mischief one-liner shown conspiratorially on the kid surface.
    var mischiefHook: String = ""

    var system: SensorySystem {
        get { SensorySystem(rawValue: systemRaw) ?? .auditory }
        set { systemRaw = newValue.rawValue }
    }
    var captureMode: CaptureMode {
        get { CaptureMode(rawValue: captureModeRaw) ?? .either }
        set { captureModeRaw = newValue.rawValue }
    }
    var phoneHolder: PhoneHolder {
        get { PhoneHolder(rawValue: phoneHolderRaw) ?? .parentRun }
        set { phoneHolderRaw = newValue.rawValue }
    }

    init(id: UUID = UUID(),
         title: String = "",
         animalTheme: String = "",
         system: SensorySystem = .auditory,
         captureMode: CaptureMode = .either,
         phoneHolder: PhoneHolder = .parentRun,
         setup: String = "",
         steps: [String] = [],
         watchFor: [String] = [],
         likelyMeaning: String = "",
         tags: [String] = [],
         interestMatch: [String] = [],
         isFirstSet: Bool = false,
         displayOrder: Int = 0,
         mischiefHook: String = "") {
        self.id = id
        self.title = title
        self.animalTheme = animalTheme
        self.systemRaw = system.rawValue
        self.captureModeRaw = captureMode.rawValue
        self.phoneHolderRaw = phoneHolder.rawValue
        self.setup = setup
        self.steps = steps
        self.watchFor = watchFor
        self.likelyMeaning = likelyMeaning
        self.tags = tags
        self.interestMatch = interestMatch
        self.isFirstSet = isFirstSet
        self.displayOrder = displayOrder
        self.mischiefHook = mischiefHook
    }
}

/// A play instance. The child starts it on the iPad; parent captures bind to it.
@Model
final class GameSession {
    var id: UUID = UUID()
    var childId: UUID = UUID()
    var gameId: UUID = UUID()
    var deviceId: UUID = UUID()
    var startedAt: Date = Date()
    var endedAt: Date?

