import Foundation
import SwiftData

// MARK: - Seed data
//
// Ship non-empty & smart. On first launch we load:
//   • The first child profile (animals + water; PDA, light-sensitive).
//   • The three FIRST-SET hook animals (gross-loud, sneaky, gross-messy).
//   • The broader generic-animal game library (V/P/T/A/PR), so IMPROVE has range.
//   • Two real seed observations (the vacuum control-flip) so IMPROVE is live on
//     first open and the control-flip insight fires immediately.

enum SeedData {

    // Stable IDs so kid + parent surfaces reference the same family/child.
    static let familyID = UUID(uuidString: "11111111-1111-1111-1111-111111111111")!
    static let childID  = UUID(uuidString: "22222222-2222-2222-2222-222222222222")!
    static let parentID = UUID(uuidString: "33333333-3333-3333-3333-333333333333")!

    // First-set game IDs (referenced by the kid surface masks).
    static let lionID       = UUID(uuidString: "AA000000-0000-0000-0000-000000000000")!
    static let grossLoudID  = UUID(uuidString: "AA000000-0000-0000-0000-000000000001")!
    static let sneakyID     = UUID(uuidString: "AA000000-0000-0000-0000-000000000002")!
    static let grossMessyID = UUID(uuidString: "AA000000-0000-0000-0000-000000000003")!

    static func seedIfNeeded(_ context: ModelContext) {
        // Only seed once: if any Game exists, assume seeded.
        let existing = try? context.fetch(FetchDescriptor<Game>())
        guard (existing?.isEmpty ?? true) else {
            // Already seeded (e.g. from before the Lion Cub existed) — make sure
            // the lion is present so existing installs get him without a reinstall.
            ensureLion(context, existing ?? [])
            migrateDonkeyToBuck(context, existing ?? [])
            return
        }

        // Family + child + a parent member.
        let family = Family(id: familyID, name: "Our Family")
        let child = Child(
            id: childID,
            familyId: familyID,
            displayName: "Gabriel",
            interests: ["animals", "water"],          // animals primary, water secondary
            profileFlags: ["PDA", "light-sensitive"]  // known accommodation: shade/overcast timing
        )
        let parent = AppUser(id: parentID, familyId: familyID, displayName: "Parent", role: .parent)
        family.children = [child]
        family.members = [parent]
        context.insert(family)
        context.insert(child)
        context.insert(parent)

        seedGames(context)
        seedObservations(context)

        try? context.save()
    }

    // MARK: First-set + library games

    private static func seedGames(_ context: ModelContext) {
        let games: [Game] = firstSetGames() + libraryGames()
        games.forEach { context.insert($0) }
    }

    /// Refreshes the donkey's display copy for installs seeded when it was the
    /// "farting" open-mouth game (now it's a head-back BUCK).
    private static func migrateDonkeyToBuck(_ context: ModelContext, _ existing: [Game]) {
        guard let donkey = existing.first(where: { $0.id == grossLoudID }),
              donkey.mischiefHook != "Throw your head back and watch this donkey BUCK!" else { return }
        donkey.title = "The bucking donkey"
        donkey.mischiefHook = "Throw your head back and watch this donkey BUCK!"
        donkey.system = .vestibular
        try? context.save()
    }

    /// Inserts the Lion Cub for installs seeded before he existed.
    private static func ensureLion(_ context: ModelContext, _ existing: [Game]) {
        guard !existing.contains(where: { $0.id == lionID }) else { return }
        // displayOrder -1 guarantees he leads regardless of the others' values.
        context.insert(makeLionGame(displayOrder: -1))
        try? context.save()
    }

    private static func makeLionGame(displayOrder: Int) -> Game {
        Game(
            id: lionID,
            title: "Lion Cub’s mighty roar",
            animalTheme: "lion",
            system: .auditory,
            captureMode: .guided,
            phoneHolder: .kidFacing,
            setup: "Hand him the iPad. He becomes Lion Cub. No instruction — just ‘ooh, this little lion is getting LOUD.’",
            steps: [
                "He sees himself become a lion cub — golden mane and all — in the mirror.",
                "Opening his mouth lets out a roar — instantly.",
                "The more he roars, the more ROAR POWER builds, up to a mighty ROOAR. Escalate the glee, not the difficulty."
            ],
            watchFor: [
                "Seeking the loud roar vs. covering ears / pulling back",
                "Does HE keep re-triggering it (his finger on the volume of his own voice)?",
                "How big does he let it get before the payoff"
            ],
            likelyMeaning: "Auditory seeking with HIM in control of the loud sound — and proud of it.",
            tags: ["loud", "control-lever", "his-animal"],
            interestMatch: ["animals"],
            isFirstSet: true,
            displayOrder: displayOrder,
            mischiefHook: "Lion Cub is about to get LOUD… let it RIP."
        )
    }

    /// The 1.0 hook animals — sneaky + gross lane, built in the child's lane.
    /// Led by the LION CUB (his animal).
    private static func firstSetGames() -> [Game] {
        let lion = makeLionGame(displayOrder: 0)

        let grossLoud = Game(
            id: grossLoudID,
            title: "The bucking donkey",
            animalTheme: "donkey",
            system: .vestibular,
            captureMode: .guided,
            phoneHolder: .kidFacing,
            setup: "Hand him the iPad. He becomes the donkey. No instruction — just ‘ooh, this donkey looks like it wants to KICK.’",
            steps: [
                "He sees himself become a donkey (long ears, muzzle) in the mirror.",
                "Throwing his head back (chin up) makes the donkey BUCK and bray — instantly.",
                "Bigger head-toss = bigger kick. KICK POWER builds to a mighty MEGA KICK."
            ],
            watchFor: [
                "Does he tip his head back freely, or is the big head movement hard / avoided?",
                "Can he grade it — small nod vs. full buck — and repeat the motion?",
                "Does the head-extension delight him or unsettle him (vestibular)?"
            ],
            likelyMeaning: "Vestibular + gross-motor: tolerance for head-back movement, with HIM in control of a big body action.",
            tags: ["movement", "vestibular", "control-lever"],
            interestMatch: ["animals"],
            isFirstSet: true,
            displayOrder: 1,
            mischiefHook: "Throw your head back and watch this donkey BUCK!"
        )

        let sneaky = Game(
            id: sneakyID,
            title: "The sneaky one",
            animalTheme: "raccoon",
            system: .praxis,
            captureMode: .guided,
            phoneHolder: .kidFacing,
            setup: "He becomes the raccoon. Tiptoe, freeze, creep… then POUNCE. The keep-coming-back animal.",
            steps: [
                "He becomes a raccoon (mask, whiskers) in the mirror.",
                "Sneak slowly — the quieter and smoother he moves, the sneakier the raccoon.",
                "Freeze… then explode into a pounce. Repeat, sneakier each time."
            ],
            watchFor: [
                "Can he grade movement — slow and smooth vs. all-or-nothing?",
                "Timing of the freeze and the pounce (sequencing)",
                "Does he imitate / sequence the sneak?"
            ],
            likelyMeaning: "Praxis & motor sequencing — sneaking IS self-regulated movement.",
            tags: ["sneaky", "movement-grading"],
            interestMatch: ["animals"],
            isFirstSet: true,
            displayOrder: 2,
            mischiefHook: "Shhh. Don’t let anyone catch the raccoon…"
        )

        let grossMessy = Game(
            id: grossMessyID,
            title: "Barf-and-shake-off",
            animalTheme: "pig",
            system: .tactile,
            captureMode: .guided,
            phoneHolder: .kidFacing,
            setup: "He becomes the pig/dog. Roll in the slop, then a giant whole-body wet shake-off.",
            steps: [
                "He becomes a pig (snout, ears) in the mirror.",
                "Roll in the (cartoon) mud and slop — gleeful and gross.",
                "Then a huge shake-off — his real shake drives the animal’s shake."
            ],
            watchFor: [
                "Does he lean into mess/wet, or pull back / want it off?",
                "The shake-off as a big proprioceptive/vestibular release",
                "Tactile reactions to the messy theme"
            ],
            likelyMeaning: "Tactile reactions to mess/wet, plus a proprioceptive/vestibular shake-off release.",
            tags: ["gross", "messy", "shake-off"],
            interestMatch: ["animals"],
            isFirstSet: true,
            displayOrder: 3,
            mischiefHook: "Pigs LOVE mud. You’re a pig now."
        )

        return [lion, grossLoud, sneaky, grossMessy]
    }

    /// The broader seed library (generic animals). Not all are 1.0 kid surfaces,
