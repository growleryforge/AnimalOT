        [
            Game(title: "Fly like the bird / swing like the monkey", animalTheme: "bird/monkey",
                 system: .vestibular, captureMode: .either, phoneHolder: .parentRun,
                 setup: "Swing already moving, or parent on it being the animal. Child joins; no ‘come swing.’",
                 steps: ["Pick a flying/swinging animal", "The swing IS that animal moving", "Child joins the moving swing"],
                 watchFor: ["Seeks more & never dizzy?", "Stops fast?", "Calmer after?"],
                 likelyMeaning: "Vestibular seeking vs. caution; regulation effect.",
                 tags: ["vestibular"], interestMatch: ["animals"]),

            Game(title: "Otter float", animalTheme: "otter",
                 system: .vestibular, captureMode: .quick, phoneHolder: .parentRun,
                 setup: "Parent floating/bobbing; child joins the otter game.",
                 steps: ["Otters float and roll", "Be otters in the pool/pond"],
                 watchFor: ["Seeks being moved, going under, head tipped back?", "Or stays still/upright?"],
                 likelyMeaning: "Vestibular response with NOISE stripped out — the clean motion read.",
                 tags: ["vestibular", "water"], interestMatch: ["animals", "water"]),

            Game(title: "Feed the hungry animals", animalTheme: "farm",
                 system: .proprioceptive, captureMode: .guided, phoneHolder: .parentRun,
                 setup: "Feed/bucket pre-loaded in his path, or parent narrates the weight. Genuine purpose = PDA-acceptable.",
                 steps: ["The animals are hungry", "Carrying the heavy feed is the mission"],
                 watchFor: ["Takes it on, repeats, whole-body effort?", "Calmer after?"],
                 likelyMeaning: "Proprioceptive seeking + the regulating effect (the gold pattern).",
                 tags: ["heavy-work", "regulating"], interestMatch: ["animals"]),

            Game(title: "Burrow like a rabbit", animalTheme: "rabbit/fox",
                 system: .proprioceptive, captureMode: .guided, phoneHolder: .parentRun,
                 setup: "Build a den of cushions/blankets to be squished/wrapped in; offer, don’t instruct.",
                 steps: ["Rabbits/foxes make tight cozy dens", "Be squished/wrapped/weighted"],
                 watchFor: ["Seeks being squished/wrapped/weighted, asks for tighter?", "Settles?"],
                 likelyMeaning: "Deep-pressure seeking — the most portable regulation tool.",
                 tags: ["deep-pressure", "regulating"], interestMatch: ["animals"]),

            Game(title: "Guess the animal by feel", animalTheme: "varied",
                 system: .tactile, captureMode: .guided, phoneHolder: .parentRun,
                 setup: "Handle varied-texture animals/materials near him; parent explores them aloud.",
                 steps: ["Soft, smooth, coarse, feathery — different animals feel different"],
                 watchFor: ["Which textures sought vs. recoiled?", "Light unexpected touch worse than firm?"],
