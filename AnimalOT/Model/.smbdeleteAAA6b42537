            Game(title: "Pig in the mud", animalTheme: "pig",
                 system: .tactile, captureMode: .quick, phoneHolder: .parentRun,
                 setup: "Parent already in the messy/wet activity; child joins.",
                 steps: ["Pigs love mud", "Be pigs"],
                 watchFor: ["Plunges into wet/sticky?", "Or stays clean, must wash immediately?"],
                 likelyMeaning: "Tactile defensiveness to wet/sticky (classic triggers).",
                 tags: ["tactile", "wet", "messy"], interestMatch: ["animals", "water"]),

            Game(title: "Animal sound match", animalTheme: "varied",
                 system: .auditory, captureMode: .either, phoneHolder: .parentRunChildSees,
                 setup: "Playful sound game; child can control volume / which sound plays (control lever built in).",
                 steps: ["App plays generic animal sounds at varied volume/pitch", "Child matches/finds the animal"],
                 watchFor: ["Covers ears / startles at certain sounds?", "Seeks loud?", "Note WHICH sounds"],
                 likelyMeaning: "Auditory defensiveness AND the control-flip (his finger on the volume vs. not).",
                 tags: ["auditory", "control-lever"], interestMatch: ["animals"]),

            Game(title: "Move like the animal", animalTheme: "varied",
                 system: .praxis, captureMode: .guided, phoneHolder: .kidFacing,
                 setup: "Played as silly animal mimicry, not a command. The on-device animal models the movement.",
