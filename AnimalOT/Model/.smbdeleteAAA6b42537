    // MARK: Seed observations (the vacuum control-flip)

    private static func seedObservations(_ context: ModelContext) {
        // Entry A — HE suggested + ran the vacuum himself.
        let entryA = SensoryObservation(
            childId: childID,
            authorId: parentID,
            timestamp: Date().addingTimeInterval(-86_400 * 9),
            system: .auditory,
            pattern: "tolerated",
            control: .controlMet,
            description: "Dumped chips; HE suggested and ran the vacuum himself.",
            beforeState: "amped up",
            afterState: "calm, pleased with himself",
            intensity: 2,
            context: "Kitchen, his idea",
            tags: ["self-initiated"]
        )

        // Entry B — parents ran the loud machines; imposed.
        let entryB = SensoryObservation(
            childId: childID,
            authorId: parentID,
            timestamp: Date().addingTimeInterval(-86_400 * 4),
            system: .auditory,
            pattern: "tolerated-but-hated",
            control: .controlAbsent,
            description: "Painted carpet; parents ran the vacuum + steam cleaner.",
            beforeState: "fine",
            afterState: "tense, no meltdown but hated it",
            intensity: 4,
            context: "Living room, our idea",
            tags: ["imposed", "no-meltdown"]
        )

        context.insert(entryA)
        context.insert(entryB)
    }
}
